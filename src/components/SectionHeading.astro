---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  tone = 'light',
  as: Heading = 'h2',
  class: className = '',
} = Astro.props;

const headingSize =
  Heading === 'h1'
    ? 'text-4xl sm:text-5xl lg:text-[3.4rem] leading-[1.05]'
    : 'text-3xl sm:text-4xl leading-[1.12]';
---

<div
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {eyebrow && (
    <p class:list={['eyebrow mb-5', align === 'center' && 'justify-center', tone === 'dark' && 'text-azure-300']}>
      {eyebrow}
    </p>
  )}
  <Heading class:list={[headingSize, 'font-semibold', tone === 'dark' ? 'text-white' : 'text-navy-900']}>
    {title}
  </Heading>
  {description && (
    <p class:list={['mt-5 text-[1.02rem] leading-relaxed sm:text-lg', tone === 'dark' ? 'text-navy-100/80' : 'text-muted']}>
      {description}
    </p>
  )}
  <slot />
</div>
