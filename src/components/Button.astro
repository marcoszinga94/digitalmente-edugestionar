---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'ghost';
  size?: 'md' | 'sm';
  arrow?: boolean;
  external?: boolean;
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  arrow = false,
  external = false,
  download = false,
  class: className = '',
} = Astro.props;

const variants = {
  primary:
    'bg-navy-800 text-white shadow-sm hover:bg-navy-900 active:bg-navy-950',
  secondary:
    'border border-navy-200 bg-white text-navy-800 hover:border-navy-300 hover:bg-navy-50',
  light:
    'bg-white text-navy-900 shadow-sm hover:bg-navy-50',
  ghost:
    'text-navy-800 hover:bg-navy-50',
};

const sizes = {
  md: 'px-5 py-3 text-[0.9rem]',
  sm: 'px-4 py-2 text-[0.82rem]',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md font-semibold tracking-tight transition-colors duration-200',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...download ? { download: '' } : {}}
>
  <slot />
  {arrow && <Icon name="arrow-right" class="h-4 w-4" />}
</a>
