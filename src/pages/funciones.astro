---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { product, featureGroups, businessRules } from '../data/product';

const roles = [
  {
    title: 'Administrador',
    icon: 'shield' as const,
    description: 'Acceso completo a la gestión académica y a la configuración del sistema.',
    items: [
      'Alumnos, carreras, materias y correlatividades',
      'Usuarios, roles y asignación de materias',
      'Exportación e importación de datos',
      'Todas las pantallas y reportes',
    ],
  },
  {
    title: 'Profesor',
    icon: 'users' as const,
    description: 'Trabaja únicamente con las materias y carreras que tiene asignadas.',
    items: [
      'Panel de inicio acotado a sus carreras',
      'Carga y edición de notas de sus materias',
      'Listados restringidos a su alcance',
      'Sin acceso a usuarios ni respaldos',
    ],
  },
];
---

<BaseLayout
  title="Funciones"
  description="Todas las funciones de EduGestionAR: alumnos, carreras, materias, correlatividades, notas, regularidad, asistencia, exámenes, usuarios y respaldos."
>
  <section class="border-b border-line bg-sand/50">
    <div class="container-page py-14 lg:py-20">
      <div class="flex flex-wrap items-center gap-3" data-reveal>
        <p class="eyebrow">Funciones</p>
        <span class="rounded-full border border-navy-100 bg-white px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-navy-600">
          Versión {product.version}
        </span>
      </div>
      <h1 class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.06] tracking-tight text-navy-900 sm:text-5xl" data-reveal style="--reveal-delay: 60ms">
        Todo lo que hace EduGestionAR
      </h1>
      <p class="mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-muted" data-reveal style="--reveal-delay: 120ms">
        Ocho módulos que comparten una misma base de datos. Lo que se carga en alumnos,
        materias o asistencia alimenta automáticamente las notas, la regularidad y los
        indicadores del panel.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal style="--reveal-delay: 180ms">
        <Button href={product.installer.file} download>
          <Icon name="download" class="h-4 w-4" />
          Descargar demo
        </Button>
        <Button href="/documentacion" variant="secondary" arrow>Documentación</Button>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-12 py-16 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16 lg:py-20">
    <aside class="self-start lg:sticky lg:top-28">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-muted">En esta página</p>
      <nav aria-label="Índice de funciones" class="mt-4">
        <ul class="space-y-1 border-l border-line">
          {
            featureGroups.map((group, index) => (
              <li>
                <a
                  href={`#${group.id}`}
                  class="flex gap-3 border-l-2 border-transparent py-1.5 pl-4 pr-2 text-sm text-muted transition-colors hover:border-navy-300 hover:text-navy-900"
                >
                  <span class="font-display text-[0.7rem] font-semibold text-navy-500">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {group.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-8 rounded-lg border border-line bg-white p-5 shadow-card">
        <p class="font-display text-sm font-semibold text-navy-900">¿Querés verlo funcionando?</p>
        <p class="mt-2 text-xs leading-relaxed text-muted">
          Instalá la demo o coordiná una recorrida guiada con el equipo.
        </p>
        <a href="/contacto" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-navy-700 hover:text-navy-900">
          <Icon name="mail" class="h-3.5 w-3.5" />
          Escribirnos
        </a>
      </div>
    </aside>

    <div class="space-y-16">
      {
        featureGroups.map((group, index) => (
          <article id={group.id} data-reveal>
            <div class="flex items-start gap-4">
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-navy-50 text-navy-700">
                <Icon name={group.icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-navy-400">
                  Módulo {String(index + 1).padStart(2, '0')}
                </p>
                <h2 class="mt-1 font-display text-2xl font-semibold text-navy-900 sm:text-3xl">
                  {group.title}
                </h2>
              </div>
            </div>

            <p class="mt-5 text-[1.02rem] font-medium leading-relaxed text-ink/90">
              {group.summary}
            </p>

            <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_1.05fr] lg:items-start">
              <ul class="space-y-2.5">
                {group.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm leading-snug text-ink/85">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-azure-600" strokeWidth={2} />
                    {bullet}
                  </li>
                ))}
              </ul>

              <figure class="overflow-hidden rounded-lg border border-line bg-white p-1.5 shadow-card">
                <div class="flex items-center gap-2 rounded-t border-b border-line bg-sand px-3 py-2">
                  <span class="flex gap-1.5" aria-hidden="true">
                    <span class="h-2 w-2 rounded-full bg-navy-200"></span>
                    <span class="h-2 w-2 rounded-full bg-navy-200"></span>
                    <span class="h-2 w-2 rounded-full bg-navy-200"></span>
                  </span>
                  <p class="ml-1 truncate text-[0.62rem] font-medium uppercase tracking-[0.14em] text-muted">
                    EduGestionAR · {group.title}
                  </p>
                </div>
                <img
                  src={group.image}
                  alt={group.imageAlt}
                  width={group.imageWidth}
                  height={group.imageHeight}
                  loading="lazy"
                  decoding="async"
                  class="block w-full rounded-b"
                />
              </figure>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <section class="border-y border-line bg-sand/70 py-16 lg:py-20" aria-labelledby="roles">
    <div class="container-page">
      <SectionHeading
        eyebrow="Roles y permisos"
        title="Cada persona ve lo que necesita"
        description="El mismo sistema, con dos alcances distintos. Los permisos se aplican en las pantallas y en los listados."
      />

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          roles.map((role) => (
            <article class="rounded-lg border border-line bg-white p-6 shadow-card">
              <div class="flex items-center gap-3">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-md bg-navy-50 text-navy-700">
                  <Icon name={role.icon} class="h-5 w-5" />
                </span>
                <h3 class="font-display text-lg font-semibold text-navy-900">{role.title}</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted">{role.description}</p>
              <ul class="mt-5 space-y-2.5 border-t border-line pt-4">
                {role.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm leading-snug text-ink/80">
                    <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-azure-500" aria-hidden="true"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20" aria-labelledby="reglas">
    <div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading
        eyebrow="Reglas de negocio"
        title="Criterios explícitos, no cálculos escondidos"
        description="Las reglas académicas están definidas y se aplican de forma consistente en todo el sistema."
      />

      <ol class="space-y-4">
        {
          businessRules.map((rule, index) => (
            <li class="flex gap-4 border-b border-line pb-4">
              <span class="font-display text-sm font-bold text-navy-500">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-sm leading-relaxed text-ink/85">{rule}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pb-20">
    <div class="container-page">
      <div class="flex flex-col items-start justify-between gap-6 rounded-xl border border-navy-100 bg-navy-50/60 p-8 sm:flex-row sm:items-center sm:p-10">
        <div class="max-w-xl">
          <h2 class="font-display text-2xl font-semibold text-navy-900">Probalo con la base de ejemplo</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            La demo incluye alumnos, docentes, carreras y materias para recorrer todos los módulos.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <Button href={product.installer.file} download>Descargar demo</Button>
          <Button href="/capturas" variant="secondary">Ver capturas</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
