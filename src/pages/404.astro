---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscás no existe." noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-navy-500">
      Error 404
    </p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-navy-900 sm:text-5xl">
      Esta página no existe
    </h1>
    <p class="mt-4 max-w-md text-[1.02rem] leading-relaxed text-muted">
      Puede que el enlace esté mal escrito o que el contenido se haya movido. Volvamos a un
      lugar conocido.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/" arrow>Ir al inicio</Button>
      <Button href="/contacto" variant="secondary">Contacto</Button>
    </div>
  </section>
</BaseLayout>
